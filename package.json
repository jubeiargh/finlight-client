{
  "name": "finlight-client",
  "version": "4.0.0",
  "description": "BREAKING: 4.x speaks finlight API v3 only (REST /v3, WebSocket payloadVersion 3, v3 webhooks). Stay on 3.x for API v2. finlight.me client for REST, WebSocket and webhooks.",
  "homepage": "https://finlight.me",
  "author": "Ali Büyükkakac",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jubeiargh/finlight-client.git"
  },
  "keywords": [
    "finlight",
    "news",
    "financial news",
    "api",
    "websocket",
    "webhook"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.*.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean && node scripts/sync-version.js --check",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"examples/**/*.ts\"",
    "test": "jest",
    "test:conformance": "jest test/conformance",
    "test:live": "node scripts/run-live.js",
    "examples:build": "tsc -p examples/tsconfig.json",
    "conformance:sync": "node scripts/sync-conformance.js",
    "conformance:check": "node scripts/sync-conformance.js --check",
    "readme:build": "node scripts/build-readmes.js",
    "readme:check": "node scripts/build-readmes.js --check",
    "version:sync": "node scripts/sync-version.js",
    "pack:check": "node scripts/check-pack.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "8.49.0",
    "@typescript-eslint/parser": "8.49.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "jest": "^29.7.0",
    "prettier": "3.3.3",
    "ts-jest": "^29.4.0",
    "typescript": "5.9.3"
  }
}
